# Pinned versions for the Setonix LLM recipes. Sourced by every installer and
# launcher in llm/. Change a pin here, then re-run the installer and the
# validation job before updating the tested-version table in README.md.

# --- Storage (override in your environment; nothing here is project specific)
# Everything (installs, weights, Ollama's imported copy, logs) lives under LLM_ROOT.
# /scratch is purged after 21 days of inactivity: keep a durable copy of the
# GGUF elsewhere (e.g. Acacia) if you need it longer.
: "${LLM_ROOT:=/scratch/${PAWSEY_PROJECT:?Set PAWSEY_PROJECT}/${USER}/llm}"

# --- Model (identical GGUF for both runtimes)
MODEL_REPO=Qwen/Qwen3-32B-GGUF
MODEL_REVISION=938a7432affaec9157f883a87164e2646ae17555   # HF commit, 2025-05-09
MODEL_FILE=Qwen3-32B-Q4_K_M.gguf
MODEL_SHA256=efd971561896866f0e910cce52761ca77b1b138090c7f15fe284676d57d1f689  # HF LFS oid
MODEL_LICENSE=Apache-2.0
: "${MODEL_GGUF:=${LLM_ROOT}/models/${MODEL_FILE}}"

# --- llama.cpp (built from source with the site ROCm)
: "${LLAMA_REF:=b12807}"   # release tag or full commit SHA
LLAMA_ROCM_MODULE=rocm/7.0.1
LLAMA_CMAKE_MODULE=cmake/3.31.9
: "${LLAMA_GPU_TARGETS:=gfx90a}"
: "${LLAMA_PREFIX:=${LLM_ROOT}/llama.cpp-${LLAMA_REF}}"

# --- Ollama (upstream binary release; bundles its own ROCm user-space libraries)
OLLAMA_VERSION=v0.40.18
OLLAMA_SHA256_MAIN=b82649006cb5b54ed1237fa2d1a26a7f939a4fd03150033759acbff7ff315adf  # ollama-linux-amd64.tar.zst
OLLAMA_SHA256_ROCM=d404a0f936a69ecf7904f228f68cf65021fdf45e4b66db3fb9c8603abd206447  # ollama-linux-amd64-rocm.tar.zst
: "${OLLAMA_PREFIX:=${LLM_ROOT}/ollama-${OLLAMA_VERSION}}"
: "${OLLAMA_MODELS:=${LLM_ROOT}/ollama-models}"

# --- Serving defaults shared by both runtimes
: "${LLM_CTX:=4096}"   # override per job, e.g. LLM_CTX=32768 (Qwen3 native max 32768)

# --- Retrieval (llm/rag): embedding model, served by the same llama.cpp build
EMBED_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
EMBED_REVISION=370f27d7550e0def9b39c1f16d3fbaa13aa67728
EMBED_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
EMBED_SHA256=06507c7b42688469c4e7298b0a1e16deff06caf291cf0a5b278c308249c3e439  # HF LFS oid
EMBED_LICENSE=Apache-2.0
: "${EMBED_GGUF:=${LLM_ROOT}/models/${EMBED_FILE}}"
: "${RAG_CORPUS:=phage-microbiome}"   # llm/rag/corpus/<name>.manifest.tsv
: "${RAG_ROOT:=${LLM_ROOT}/rag/${RAG_CORPUS}}"   # XML, passages, index
