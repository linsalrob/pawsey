#!/bin/bash
# sbatch-usage: sbatch with the job_usage SPANK plugin's options, for users.
#
# Accepts every sbatch option plus
#   --job-usage[=text|csv|json|off]   report on the job when it ends
#   --job-usage-output=PATH           where to write it (%j = job id, %u = user)
# or, inside the job script (sbatch itself rejects unknown #SBATCH options):
#   #JOB_USAGE --job-usage=json --job-usage-output=usage/%j.json
#
# It submits the job, then a small follow-on job (afterany) that runs
# job_usage_epilog.sh, which appends the job_usage.sh report to the job's
# stdout file. For a job array, every element is reported, in one file,
# <WorkDir>/job_usage-<array id>.<txt|csv|json>. With --wait the report is
# written from here once sbatch returns, with no extra job.
#
# The --job-usage options are removed wherever they appear on the command
# line, so do not pass them as arguments to the job script itself.
#
# Environment:
#   JOB_USAGE_SBATCH        real sbatch to call (default /usr/bin/sbatch)
#   JOB_USAGE_SBATCH_ARGS   extra options for the report job, e.g. a partition

HERE=$(dirname "$(readlink -f "$0")")
HELPER="$HERE/job_usage_epilog.sh"
SCRIPT="$HERE/job_usage.sh"
SELF="$HERE/$(basename "$0")"
REAL_SBATCH=${JOB_USAGE_SBATCH:-/usr/bin/sbatch}

die() { echo "sbatch-usage: $*" >&2; exit 1; }

valid_format() { [[ "$1" =~ ^(text|csv|json|off)$ ]]; }

ext_for() { case "$1" in csv) echo csv ;; json) echo json ;; *) echo txt ;; esac; }

# --report ID FORMAT OUTPUT: run inside the follow-on job (or after --wait).
report() {
    local jobid=$1 format=$2 output=$3
    local ids first=1 id
    # --export=NONE report jobs start with a minimal environment.
    export PATH="${PATH:+$PATH:}/usr/local/bin:/usr/bin:/bin"
    # Use <array id>_<task id> for array elements, not their raw ids: the
    # last element's raw id is the array id, which sacct expands to all.
    mapfile -t ids < <(sacct -n -X -P -j "$jobid" --format=JobID 2>/dev/null | grep -E '^[0-9]+(_[0-9]+)?$' | sort -t_ -k1,1n -k2,2n -u)
    [[ ${#ids[@]} -eq 0 ]] && ids=("$jobid")
    for id in "${ids[@]}"; do
        local extra=()
        [[ "$format" == "csv" && $first -eq 0 ]] && extra=(--no-csv-header)
        "$HELPER" --jobid "$id" --format "$format" --output "$output" \
            --script "$SCRIPT" --any-host "${extra[@]}"
        first=0
    done
}

if [[ "$1" == "--report" ]]; then
    [[ $# -eq 4 ]] || die "usage: $0 --report JOBID FORMAT OUTPUT"
    report "$2" "$3" "$4"
    exit $?
fi

# --- Split our options from sbatch's --- #
FORMAT=""
OUTPUT=""
USER_PARSABLE=0
WAIT=0
PASSTHROUGH=0
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --job-usage)          FORMAT=text ;;
        --job-usage=*)        FORMAT=${1#*=} ;;
        --job-usage-output)   OUTPUT=$2; shift ;;
        --job-usage-output=*) OUTPUT=${1#*=} ;;
        *)
            case "$1" in
                --parsable) USER_PARSABLE=1 ;;
                -W|--wait) WAIT=1 ;;
                -h|--help|--usage|-V|--version|--test-only) PASSTHROUGH=1 ;;
            esac
            args+=("$1")
            ;;
    esac
    shift
done

if [[ $PASSTHROUGH -eq 1 ]]; then
    exec "$REAL_SBATCH" "${args[@]}"
fi
if [[ -n "$FORMAT" ]] && ! valid_format "$FORMAT"; then
    die "--job-usage takes text, csv, json or off, not '$FORMAT'"
fi

# --- Submit the job --- #
out=$("$REAL_SBATCH" --parsable "${args[@]}")
rc=$?
jobid=${out%%;*}
if [[ ! "$jobid" =~ ^[0-9]+$ ]]; then
    [[ -n "$out" ]] && echo "$out"
    exit $rc
fi
if [[ $USER_PARSABLE -eq 1 ]]; then
    echo "$out"
else
    echo "Submitted batch job $jobid"
fi

# #JOB_USAGE lines in the submitted script apply when the command line
# did not set the same thing.
if [[ -z "$FORMAT" || -z "$OUTPUT" ]]; then
    while read -r -a words; do
        for w in "${words[@]:1}"; do
            case "$w" in
                --job-usage)          [[ -z "$FORMAT" ]] && FORMAT=text ;;
                --job-usage=*)        [[ -z "$FORMAT" ]] && FORMAT=${w#*=} ;;
                --job-usage-output=*) [[ -z "$OUTPUT" ]] && OUTPUT=${w#*=} ;;
            esac
        done
    done < <(scontrol write batch_script "$jobid" - 2>/dev/null | grep -E '^#JOB_USAGE([[:space:]]|$)')
    [[ -n "$OUTPUT" && -z "$FORMAT" ]] && FORMAT=text
    if [[ -n "$FORMAT" ]] && ! valid_format "$FORMAT"; then
        echo "sbatch-usage: ignoring #JOB_USAGE format '$FORMAT'" >&2
        exit $rc
    fi
fi
[[ -z "$FORMAT" || "$FORMAT" == "off" ]] && exit $rc

# --- Work out where the report goes --- #
job_info=$(scontrol show job -o "$jobid" 2>/dev/null)
field() { grep -oP "(^| )$1=\K\S*" <<< "$job_info" | head -1; }
work_dir=$(field WorkDir)
std_out=$(field StdOut)
account=$(field Account)
array_tasks=$(field ArrayTaskId)
[[ -z "$work_dir" || "$work_dir" == "(null)" ]] && work_dir=$PWD

if [[ -n "$OUTPUT" ]]; then
    [[ "$OUTPUT" == /* ]] || OUTPUT="$work_dir/$OUTPUT"
    OUTPUT=${OUTPUT//%j/$jobid}
    OUTPUT=${OUTPUT//%u/$USER}
elif [[ -n "$array_tasks" ]]; then
    # A pending array's StdOut is not a real element's path, so collect
    # all elements in one file instead.
    OUTPUT="$work_dir/job_usage-$jobid.$(ext_for "$FORMAT")"
elif [[ -n "$std_out" && "$std_out" != "(null)" && "$std_out" != /dev/* ]]; then
    OUTPUT=$std_out
else
    OUTPUT="$work_dir/job_usage-$jobid.$(ext_for "$FORMAT")"
fi

# --- With --wait the job is over: report now, from here --- #
if [[ $WAIT -eq 1 ]]; then
    report "$jobid" "$FORMAT" "$OUTPUT"
    exit $rc
fi

# --- Otherwise submit the report as a follow-on job --- #
# One minute of overhead plus ~3 s per array element for job_usage.sh.
n_tasks=1
[[ -n "$array_tasks" ]] && n_tasks=$(scontrol show hostnames "x[${array_tasks%%%*}]" 2>/dev/null | wc -l)
(( n_tasks < 1 )) && n_tasks=1
minutes=$(( 10 + (n_tasks * 3 + 59) / 60 ))

# The report needs no GPU; Setonix GPU accounts end in -gpu.
report_args=(--parsable --dependency="afterany:$jobid" --job-name="job_usage-$jobid"
             --ntasks=1 --cpus-per-task=1 --mem=1G --time="$minutes"
             --output=/dev/null --export=NONE)
[[ -n "$account" ]] && report_args+=(--account="${account%-gpu}")
# shellcheck disable=SC2206
report_args+=($JOB_USAGE_SBATCH_ARGS)

# Do not let SBATCH_* settings meant for the user's job (array, output,
# dependency, GPUs, ...) leak into the report job.
unset_args=()
for v in $(compgen -e | grep '^SBATCH_'); do unset_args+=(-u "$v"); done

rid=$(env "${unset_args[@]}" "$REAL_SBATCH" "${report_args[@]}" \
      --wrap="$(printf '%q ' "$SELF" --report "$jobid" "$FORMAT" "$OUTPUT")")
if [[ "${rid%%;*}" =~ ^[0-9]+$ ]]; then
    echo "sbatch-usage: job ${rid%%;*} will write the $FORMAT report to $OUTPUT" >&2
else
    echo "sbatch-usage: could not submit the report job for $jobid" >&2
fi
exit $rc
