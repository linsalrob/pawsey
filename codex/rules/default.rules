prefix_rule(pattern=["/usr/bin/bash", "-lc", "printf \"%s\\n\" \"Completed QA tables\"; find vamb_crass -path \"*/hierarchical_vamb/*/qa.tsv\" -type f -printf \"%p\\n\" 2>/dev/null | sort; printf \"%s\\n\" \"Quality summaries\"; for path in $(find vamb_crass -path \"*/hierarchical_vamb/*/qa.tsv\" -type f 2>/dev/null | sort); do awk -F \"\\t\" -v p=\"$path\" \"NR>1 {c=\\$12; x=\\$13; n++; if(c>=90 && x<5) hq++; if(c>=50 && c<90 && x<10) mq++; if(c>=50 && x<10) usable++; if(c>=90 && x>=5) contaminated++; if(c<10) low++; sumc+=c; sumx+=x} END {printf \\\"%s\\\\tn=%d\\\\thq=%d\\\\tmedium_only=%d\\\\tusable=%d\\\\tnear_complete_contaminated=%d\\\\tlow_complete=%d\\\\tmeanC=%.2f\\\\tmeanContam=%.2f\\\\n\\\",p,n,hq,mq,usable,contaminated,low,sumc/n,sumx/n}\" \"$path\"; done; printf \"%s\\n\" \"CheckM job terminal states\"; sacct -u \"$USER\" -n -X --name=checkm,checkmBatch --format=JobID,JobName,State,Elapsed,ExitCode -P | tail -40"], decision="allow")
